# Copie para .env (na raiz do projeto) e preencha. O .env NÃO vai para o git.
# Usado pelo docker-compose.yml (veja servidor.md).

# Domínio que aponta para este servidor (sem https://). Obrigatório no perfil "https".
DASHZON_DOMINIO=painel.seudominio.com.br

# Com HTTPS (perfil "https"), deixe 1: o cookie de login só trafega criptografado.
DASHZON_COOKIE_SEGURO=1

# Endereço usado nos links de e-mail/redefinição de senha.
DASHZON_URL_PUBLICA=https://painel.seudominio.com.br

# Porta local do DashZon (só nesta máquina).
DASHZON_PORTA=4567

# E-mail (opcional): confirmação de e-mail e "esqueci a senha".
DASHZON_SMTP_HOST=
DASHZON_SMTP_PORTA=587
DASHZON_SMTP_USUARIO=
DASHZON_SMTP_SENHA=
DASHZON_SMTP_REMETENTE=
