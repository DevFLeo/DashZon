# --- Banco de dados local ---------------------------------------------------
# Criado em runtime pelo assistente de setup; nunca vai para o repositório.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
# Backups gerados ao arquivar um banco de schema antigo (dashzon.db.<data>.bak)
*.bak

# --- JSON do usuário ----------------------------------------------------------
# Templates importados e exportações/backups ficam no banco (tabela `jsons`).
# Só os templates padrão e as configs do VS Code são versionados; qualquer
# outro .json (ex.: um template solto em backend/templates/) fica fora do git.
*.json
!/backend/templates/financas-pessoais.json
!/backend/templates/fluxo-caixa.json
!/backend/templates/gestao-demandas.json
!/backend/templates/mapeamento-setor.json
!/backend/templates/cronograma-estudos.json
!/backend/templates/anotacoes.json
!/.vscode/*.json

# --- Log local de problemas/bugs ----------------------------------------------
# Diário de desenvolvimento só desta máquina. Ancorado na raiz para não pegar
# o docs/DESENVOLVIMENTO.md (o Windows não diferencia maiúsculas).
/desenvolvimento.md

# --- Configuração de ambiente / servidor -----------------------------------
.env
.env.*
!.env.example

# --- Motor C++ (CMake / Visual Studio) -------------------------------------
engine-cpp/build/
engine-cpp/out/
/build/
/out/
.vs/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
cmake-build-*/
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib

# --- Ruby / bundler ---------------------------------------------------------
backend/.bundle/
backend/vendor/bundle/
.ruby-lsp/
coverage/
tmp/
*.gem

# --- Python (importador de planilhas) ----------------------------------------
__pycache__/
*.pyc

# --- Empacotamento (executável) --------------------------------------------
dist/

# --- Logs --------------------------------------------------------------------
log/
*.log

# --- Editores e sistema operacional -----------------------------------------
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# --- Publicação (deploy/) ------------------------------------------------------
# publico.env tem o token do DuckDNS; bin/ é o caddy.exe baixado; logs/ os logs.
deploy/publico.env
deploy/*.env
!deploy/publico.env.example
deploy/bin/
deploy/logs/
