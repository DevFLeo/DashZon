# Copie este arquivo para deploy/publico.env e preencha.
# O publico.env NÃO vai para o git (tem o token do DuckDNS).

# Só o nome, sem ".duckdns.org". Ex.: para meupainel.duckdns.org -> meupainel
DUCKDNS_DOMINIO=meupainel

# Token da sua conta no duckdns.org (aparece no topo da página, depois do login).
DUCKDNS_TOKEN=cole-o-token-aqui

# Porta aberta no roteador (a que vai no endereço: https://meupainel.duckdns.org:2444)
PORTA_PUBLICA=2444
