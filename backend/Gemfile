source "https://rubygems.org"

gem "sinatra", "~> 4.1"
gem "rackup", "~> 2.1"
gem "webrick", "~> 1.8"
# Servidor HTTP mais rápido (threads, keep-alive), só fora do Windows (Linux/Docker):
# no Windows ele exige compilar extensões com o MSYS2. Lá o WEBrick segue valendo.
gem "puma", "~> 7.0", platforms: :ruby
gem "sqlite3", "~> 2.1"
# Leitura de CSV (importação de extratos). No Ruby 3.4 deixou de ser padrão.
gem "csv", "~> 3.3"
# Envio de e-mail (verificação e redefinição de senha), quando houver SMTP.
gem "net-smtp", "~> 0.5"

group :test do
  gem "minitest", "~> 5.25"
  gem "rack-test", "~> 2.2"
  gem "rake", "~> 13.2"
end
